# Configuración de Base de Datos para Payments Service (db_pagos_inka)
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=db_pagos_inka
DATABASE_URL=mysql+pymysql://root:@localhost:3306/db_pagos_inka

# Adaptador de pasarela: "mock" (pruebas locales inmediatas) o "culqi" (Culqi Sandbox/Live)
PAYMENT_PROVIDER=mock

# Credenciales opcionales para Culqi (solo requeridas si PAYMENT_PROVIDER=culqi)
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=
CULQI_API_URL=https://api.culqi.com/v2
